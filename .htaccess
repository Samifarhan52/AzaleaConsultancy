# ====================================================================
# AZALEA TOURISM & CONSULTANCY - HOSTINGER / APACHE PRODUCTION CONFIG
# ====================================================================

# Force index.html as the primary homepage
DirectoryIndex index.html index.php index.htm

# Enable URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Canonical Clean URL: Redirect /index.html directly to /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/ [NC]
    RewriteRule ^(.*)index\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 3. Canonical Clean URL: Redirect any request with .html extension to clean URL (Exclude Google verification files)
    RewriteCond %{REQUEST_URI} !^/google[a-z0-9]+\.html$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\s?]+)\.html[\s?] [NC]
    RewriteRule ^([^\s?]+)\.html$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 4. Clean Dedicated Routes
    RewriteRule ^form/?$ form.html [L,QSA]
    RewriteRule ^privacy-policy/?$ privacy-policy.html [L,QSA]
    RewriteRule ^terms-conditions/?$ terms-conditions.html [L,QSA]
    RewriteRule ^about-us/?$ about-us.html [L,QSA]
    RewriteRule ^service/?$ service.html [L,QSA]
    RewriteRule ^our-countries/?$ our-countries.html [L,QSA]
    RewriteRule ^contact/?$ contact.html [L,QSA]
    RewriteRule ^faq/?$ faq.html [L,QSA]
    RewriteRule ^404/?$ 404.html [L,QSA]

    # 5. Internal Mapping: Serve .html file silently when clean URL is requested
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^\s]+)/?$ $1.html [L,QSA]

    # 6. Custom Error Handling (Hostinger & Apache)
    ErrorDocument 404 /404.html
    ErrorDocument 500 /404.html
</IfModule>

# Browser Caching for Maximum Speed
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Compression for Fast Page Loads
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json font/woff2 font/woff
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
